summon {
  encode_uri(value: string): Exception<string, JsError>,
  decode_uri(value: string): Exception<string, JsError>
} from "../boundary.mjs"
summon { total lone_surrogate(): string } from "./fixtures.mjs"
import { echo } from "io"

import { header, value, parse, all, has, get, build_set_cookie, clear_cookie, bag_value } from "../index.ds"

fn fail(msg: string) {
  echo(msg)
}

fn req(cookie: string) {
  return { headers: Some({ cookie: Some(cookie) }) }
}

fn contains(hay: string, needle: string) boolean {
  return hay.includes(needle)
}

fn field_of(header: string, key: string) string {
  const bag = parse(header)
  return match (bag_value(bag, key)) { Some(v) => v, None => "" }
}

fn unwrap_set(r: Result<string, string>) string {
  return match (r) {
    Ok(v) => v,
    Err(e) => e,
  }
}

fn go() {
  const jar = "_ga=1; deka_sid=alice; theme=dark";
  const request = req(jar);

  if (header(request) != jar) {
    fail("fail-header");
    return;
  }

  if (get(request, "deka_sid") != "alice") {
    fail("fail-get");
    return;
  }
  if (get(req("_ga=1; theme=dark"), "deka_sid", "missing") != "missing") {
    fail("fail-fallback");
    return;
  }
  if (value(jar, "theme") != "dark") {
    fail("fail-value");
    return;
  }
  if (get(request, "deka") != "") {
    fail("fail-prefix");
    return;
  }

  const has_sid: boolean = has(request, "deka_sid");
  const has_missing: boolean = has(request, "nope");
  if (!has_sid || has_missing) {
    fail("fail-has");
    return;
  }

  if (field_of(jar, "deka_sid") != "alice" || field_of(jar, "_ga") != "1") {
    fail("fail-parse");
    return;
  }

  const all_theme = match (bag_value(all(request), "theme")) { Some(v) => v, None => "" };
  const absent = match (bag_value(parse(jar), "missing")) { Some(v) => false, None => true };
  if (all_theme != "dark" || !absent) {
    fail("fail-all");
    return;
  }

  const ctor_jar = "constructor=evil; toString=x; deka_sid=alice";
  if (field_of(ctor_jar, "constructor") != "evil" || field_of(ctor_jar, "deka_sid") != "alice") {
    fail("fail-constructor");
    echo(field_of(ctor_jar, "constructor"));
    return;
  }

  const encoded_val = "a%20b";
  if (get(req("sid=" + encoded_val), "sid") != "a b") {
    fail("fail-decode");
    return;
  }

  const cap = { headers: Some({ Cookie: Some("sid=bob") }) };
  if (get(cap, "sid") != "bob") {
    fail("fail-cookie-header");
    return;
  }

  const built = unwrap_set(build_set_cookie("sid", "abc", {}));
  if (!contains(built, "sid=abc")) {
    fail("fail-set-name");
    echo(built);
    return;
  }
  if (!contains(built, "Path=/") || !contains(built, "Secure") || !contains(built, "HttpOnly") || !contains(built, "SameSite=Lax")) {
    fail("fail-set-defaults");
    echo(built);
    return;
  }
  if (contains(built, "Max-Age=") || contains(built, "Domain=")) {
    fail("fail-set-optional");
    echo(built);
    return;
  }

  const custom_opts = { path: Some("/app"), domain: Some("example.com"), max_age: Some(60), secure: Some(false), http_only: Some(false), same_site: Some("strict") };
  const custom = unwrap_set(build_set_cookie("sid", "x", custom_opts));
  if (!contains(custom, "Path=/app") || !contains(custom, "Domain=example.com") || !contains(custom, "Max-Age=60")) {
    fail("fail-set-custom");
    echo(custom);
    return;
  }
  if (contains(custom, "Secure") || contains(custom, "HttpOnly")) {
    fail("fail-set-flags");
    echo(custom);
    return;
  }
  if (!contains(custom, "SameSite=Strict")) {
    fail("fail-samesite-strict");
    echo(custom);
    return;
  }

  const none_opts = { same_site: Some("none"), secure: Some(true) };
  const none = unwrap_set(build_set_cookie("sid", "x", none_opts));
  if (!contains(none, "SameSite=None") || !contains(none, "Secure")) {
    fail("fail-samesite-none");
    echo(none);
    return;
  }

  const none_insecure = { same_site: Some("none"), secure: Some(false) };
  if (unwrap_set(build_set_cookie("sid", "x", none_insecure)) != "SameSite=None requires Secure") {
    fail("fail-samesite-none-secure");
    echo(unwrap_set(build_set_cookie("sid", "x", none_insecure)));
    return;
  }

  const bad_path = { path: Some("/; Domain=evil.com") };
  if (unwrap_set(build_set_cookie("sid", "v", bad_path)) != "invalid cookie path") {
    fail("fail-inject-path");
    echo(unwrap_set(build_set_cookie("sid", "v", bad_path)));
    return;
  }

  const bad_domain = { domain: Some("evil.com,x") };
  if (unwrap_set(build_set_cookie("sid", "v", bad_domain)) != "invalid cookie domain") {
    fail("fail-inject-domain");
    echo(unwrap_set(build_set_cookie("sid", "v", bad_domain)));
    return;
  }

  if (unwrap_set(build_set_cookie("sid\r\nX", "v", {})) != "invalid cookie name") {
    fail("fail-inject-name");
    echo(unwrap_set(build_set_cookie("sid\r\nX", "v", {})));
    return;
  }

  const clear_opts = { path: Some("/"), secure: Some(false) };
  const cleared = unwrap_set(clear_cookie("sid", clear_opts));
  if (!contains(cleared, "sid=") || !contains(cleared, "Max-Age=0") || !contains(cleared, "Expires=")) {
    fail("fail-clear");
    echo(cleared);
    return;
  }

  if (header({}) != "" || header({ headers: Some({}) }) != "") { fail("fail-omitted-header"); return; }
  if (field_of("__proto__=safe; constructor=first; constructor=second", "__proto__") != "safe" || field_of("constructor=first; constructor=second", "constructor") != "first") { fail("fail-bag"); return; }
  if (value("sid=%E0%A4%A", "sid") != "%E0%A4%A") { fail("fail-bad-uri-fallback"); return; }
  if (unwrap_set(clear_cookie("sid")) != "sid=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Secure; HttpOnly; SameSite=Lax") { fail("fail-clear-default"); return; }
  const uri_encode_failed = match (encode_uri(lone_surrogate())) { Ok(v) => false, Throw(e) => true };
  const uri_decode_failed = match (decode_uri("%E0%A4%A")) { Ok(v) => false, Throw(e) => true };
  if (!uri_encode_failed || !uri_decode_failed) { fail("fail-uri-exception"); return; }
  if (unwrap_set(build_set_cookie("sid", lone_surrogate())) != "sid=" + lone_surrogate() + "; Path=/; Secure; HttpOnly; SameSite=Lax") { fail("fail-encode-fallback"); return; }
  if (unwrap_set(build_set_cookie("", "x")) != "invalid cookie name" || unwrap_set(build_set_cookie("café", "x")) != "invalid cookie name") { fail("fail-name-token"); return; }
  if (unwrap_set(build_set_cookie("sid", "x", { path: Some("/") })) != "invalid cookie path" || unwrap_set(build_set_cookie("sid", "x", { domain: Some("x\r\n") })) != "invalid cookie domain") { fail("fail-attr-controls"); return; }
  echo("ok");
}

go()
