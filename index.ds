// Cookie header parse/build. No ambient $_COOKIE — pass the request (or the
// Cookie header string). Set-Cookie defaults match the PHPX module: Path=/,
// Secure, HttpOnly, SameSite=Lax.
//
// RFC 6265: cookie-name is a token; path/domain must not contain CTL, `;`,
// or `,`. Reject those rather than sanitising. SameSite=None requires Secure.

interface CookieHeaders {
  cookie: string?
  Cookie: string?
}

interface CookieRequest {
  headers: CookieHeaders?
}

interface CookieOptions {
  path: string?
  domain: string?
  max_age: number?
  expires: number?
  secure: boolean?
  http_only: boolean?
  same_site: string?
}

interface CookieHit {
  found: boolean
  value: string
}

interface CookieAttrs {
  path: string
  domain: string
  max_age: string
  expires: string
  secure: boolean
  http_only: boolean
  same_site: string
}

opaque type CookieBag
summon {
  total empty_bag() CookieBag,
  total bag_has(bag: CookieBag, key: string) boolean,
  total bag_set(bag: CookieBag, key: string, value: string) CookieBag,
  total bag_get(bag: CookieBag, key: string) Option<string>,
  encode_uri(value: string) Exception<string, JsError>,
  decode_uri(value: string) Exception<string, JsError>,
  total gmt_expires(unix: number) string
} from "./boundary.mjs"

fn header_fields(headers: CookieHeaders) string {
  const lower = match (headers.cookie) { Some(v) => v, None => "" }
  if (lower != "") { return lower }
  return match (headers.Cookie) { Some(v) => v, None => "" }
}

fn header_from(request: CookieRequest) string {
  return match (request.headers) { None => "", Some(headers) => header_fields(headers) }
}

fn encode_value(value: string) string {
  return match (encode_uri(value)) { Ok(v) => v, Throw(e) => value }
}

fn decode_value(raw: string) string {
  return match (decode_uri(raw)) { Ok(v) => v, Throw(e) => raw }
}

export fn bag_value(bag: CookieBag, key: string) Option<string> {
  return bag_get(bag, key)
}

fn cookie_name_ok(name: string) Result<boolean, string> {
  if (name == "") { return Err("invalid cookie name") }
  const allowed = "!#$%&'*+-.^_`|~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
  for (let i = 0; i < name.length; i = i + 1) {
    if (!allowed.includes(name.slice(i, i + 1))) { return Err("invalid cookie name") }
  }
  return Ok(true)
}

fn cookie_attr_ok(value: string, which: string) Result<boolean, string> {
  for (let i = 0; i < value.length; i = i + 1) {
    const ch = value.slice(i, i + 1)
    // The second literal is DEL (U+007F).
    if (ch < " " || ch == "" || ch == ";" || ch == ",") { return Err("invalid cookie " + which) }
  }
  return Ok(true)
}

// string.indexOf is modeled as (number) -> number, so this is DS instead.
fn eq_index(s: string) number {
  for (let i = 0; i < s.length; i = i + 1) {
    if (s.slice(i, i + 1) == "=") {
      return i
    }
  }
  return -1
}

fn miss() CookieHit {
  return { found: false, value: "" }
}

fn hit(value: string) CookieHit {
  return { found: true, value: value }
}

fn find_cookie(header: string, name: string) CookieHit {
  if (name == "") {
    return miss()
  }
  const parts = header.split(";")
  for (const part of parts) {
    const trimmed = part.trim()
    const eq = eq_index(trimmed)
    if (eq <= 0) {
      continue
    }
    if (trimmed.slice(0, eq) != name) {
      continue
    }
    const raw = trimmed.slice(eq + 1, trimmed.length).trim()
    return hit(decode_value(raw))
  }
  return miss()
}

interface RawOpts {
  path: string
  domain: string
  max_age: string
  has_expires: boolean
  expires_unix: number
  secure: boolean
  http_only: boolean
  same_site: string
}

fn raw_options(options: CookieOptions) RawOpts {
  return { path: match (options.path) { Some(v) => v, None => "/" }, domain: match (options.domain) { Some(v) => v, None => "" }, max_age: match (options.max_age) { Some(v) => "" + v, None => "" }, has_expires: match (options.expires) { Some(v) => true, None => false }, expires_unix: match (options.expires) { Some(v) => v, None => 0 }, secure: match (options.secure) { Some(v) => v, None => true }, http_only: match (options.http_only) { Some(v) => v, None => true }, same_site: match (options.same_site) { Some(v) => v, None => "Lax" } }
}

fn same_site_norm(value: string) string {
  const v = value.trim().toLowerCase()
  if (v == "strict") {
    return "Strict"
  }
  if (v == "none") {
    return "None"
  }
  return "Lax"
}

fn cookie_attrs_of(path: string, domain: string, max_age: string, expires: string, secure: boolean, http_only: boolean, same_site: string) CookieAttrs {
  return { path: path, domain: domain, max_age: max_age, expires: expires, secure: secure, http_only: http_only, same_site: same_site }
}

fn validated_attrs(options: CookieOptions) {
  const raw = raw_options(options)
  let same_site = same_site_norm(raw.same_site)
  if (raw.same_site == "") {
    same_site = ""
  }
  if (same_site == "None" && !raw.secure) {
    return Err("SameSite=None requires Secure")
  }
  let expires = ""
  if (raw.has_expires) {
    expires = gmt_expires(raw.expires_unix)
  }
  return match (path_ok(raw.path)) {
    Err(e) => Err(e),
    Ok(_) => match (domain_ok(raw.domain)) {
      Err(e) => Err(e),
      Ok(_) => Ok(cookie_attrs_of(raw.path, raw.domain, raw.max_age, expires, raw.secure, raw.http_only, same_site))
    }
  }
}

fn path_ok(path: string) {
  if (path == "") {
    return Ok(true)
  }
  return cookie_attr_ok(path, "path")
}

fn domain_ok(domain: string) {
  if (domain == "") {
    return Ok(true)
  }
  return cookie_attr_ok(domain, "domain")
}

fn render_set_cookie(name: string, encoded: string, attrs: CookieAttrs) string {
  let cookie = name + "=" + encoded
  if (attrs.path != "") {
    cookie = cookie + "; Path=" + attrs.path
  }
  if (attrs.domain != "") {
    cookie = cookie + "; Domain=" + attrs.domain
  }
  if (attrs.max_age != "") {
    cookie = cookie + "; Max-Age=" + attrs.max_age
  }
  if (attrs.expires != "") {
    cookie = cookie + "; Expires=" + attrs.expires
  }
  if (attrs.secure) {
    cookie = cookie + "; Secure"
  }
  if (attrs.http_only) {
    cookie = cookie + "; HttpOnly"
  }
  if (attrs.same_site != "") {
    cookie = cookie + "; SameSite=" + attrs.same_site
  }
  return cookie
}

export fn header(request: CookieRequest) string {
  return header_from(request)
}

export fn value(header: string, name: string) string {
  const found = find_cookie(header, name)
  if (found.found) {
    return found.value
  }
  return ""
}

export fn parse(header: string) {
  let out = empty_bag()
  const parts = header.split(";")
  for (const part of parts) {
    const trimmed = part.trim()
    const eq = eq_index(trimmed)
    if (eq <= 0) {
      continue
    }
    const key = trimmed.slice(0, eq)
    if (bag_has(out, key)) {
      continue
    }
    const raw = trimmed.slice(eq + 1, trimmed.length).trim()
    out = bag_set(out, key, decode_value(raw))
  }
  return out
}

export fn all(request: CookieRequest) {
  return parse(header_from(request))
}

export fn has(request: CookieRequest, name: string) boolean {
  const found = find_cookie(header_from(request), name)
  return found.found
}

export fn get(request: CookieRequest, name: string, fallback: string = "") string {
  const found = find_cookie(header_from(request), name)
  if (found.found) {
    return found.value
  }
  return fallback
}

export fn build_set_cookie(name: string, value: string, options: CookieOptions = {}) {
  return match (cookie_name_ok(name)) {
    Err(e) => Err(e),
    Ok(_) => match (validated_attrs(options)) {
      Err(e) => Err(e),
      Ok(attrs) => Ok(render_set_cookie(name, encode_value(value), attrs))
    }
  }
}

fn cleared_options(options: CookieOptions) CookieOptions {
  const raw = raw_options(options)
  return { path: Some(raw.path), domain: Some(raw.domain), max_age: Some(0), expires: Some(0), secure: Some(raw.secure), http_only: Some(raw.http_only), same_site: Some(raw.same_site) }
}

export fn clear_cookie(name: string, options: CookieOptions = {}) {
  return build_set_cookie(name, "", cleared_options(options))
}
